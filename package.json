{
  "name": "kenma",
  "private": true,
  "version": "2.0.0",
  "description": "Kenneth Ma's personal website — an Expo (React Native Web) monorepo.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @kenma/web",
    "build": "npm run build --workspace @kenma/web",
    "preview": "npm run preview --workspace @kenma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run typecheck && npm run lint"
  }
}
